{
  "name": "guito",
  "version": "0.6.2",
  "description": "Easily explore your git repositories.",
  "homepage": "https://github.com/danisss9/Guito#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/danisss9/Guito.git"
  },
  "bugs": {
    "url": "https://github.com/danisss9/Guito/issues"
  },
  "workspaces": [
    "vscode-extension"
  ],
  "bin": {
    "guito": "bin/index.js"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "node",
    "nodejs",
    "npm",
    "npx",
    "easy",
    "visual",
    "browser",
    "angular",
    "ng",
    "react",
    "vue",
    "svelte",
    "javascript",
    "typescript",
    "js",
    "ts"
  ],
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "dev:server": "tsc --project ./server/tsconfig.json && node bin/index.js --no-open",
    "start": "node bin/index.js",
    "build": "npm run build:ui && npm run build:server && npm run build:extension:bundle",
    "build:ui": "ng build",
    "build:server": "tsc --project ./server/tsconfig.json",
    "build:extension": "npm run build:ui && npm run build:extension:bundle",
    "build:extension:bundle": "npm run build --workspace vscode-extension",
    "check": "tsc --project ./server/tsconfig.json --noEmit && npm run check --workspace vscode-extension",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "package:extension": "npm run build:ui && npm run package --workspace vscode-extension",
    "build:start": "npm run build && npm run start",
    "release": "npm run build && npm publish --access public",
    "test:browser": "npm run build:ui && npm run build:server && playwright test"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "diff": "^7.0.0",
    "dompurify": "^3.4.15",
    "fastify": "^5.12.1",
    "marked": "^15.0.12",
    "monaco-editor": "^0.56.0",
    "open": "^10.0.3",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.19.43",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "typescript": "~5.8.0",
    "zone.js": "~0.15.0"
  }
}
